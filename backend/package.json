{
  "name": "luxora-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node src/index.js",
    "start": "node prisma/run-migrations.js && node src/index.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "node prisma/run-migrations.js",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "node tests/run-tests.js --suite=full",
    "test:ci": "node tests/run-tests.js",
    "test:smoke": "node tests/run-tests.js --suite=smoke",
    "test:payments": "node tests/run-tests.js --suite=payments",
    "test:bookings": "node tests/run-tests.js --suite=bookings",
    "test:security": "node tests/run-tests.js --suite=security",
    "seed": "node prisma/seed.js",
    "demo:seed": "node prisma/demo-bookings.js seed",
    "demo:clean": "node prisma/demo-bookings.js clean",
    "preflight:bank-accounts": "node prisma/migrate-bank-accounts.js --dry-run",
    "migrate:bank-accounts": "node prisma/migrate-bank-accounts.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
