# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL). For Aiven, paste the full URI from your Aiven service.
DATABASE_URL=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

PORT=5000

# Public frontend URL used in reset/payment redirects
FRONTEND_URL=http://localhost:3000

# Payments (PayHere)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=http://localhost:3000
PAYHERE_CANCEL_URL=http://localhost:3000
PAYHERE_NOTIFY_URL=

# NOWPayments Cryptocurrency Gateway
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@luxora.bond

# Meta WhatsApp Cloud API verification. Create an approved template whose body
# contains one text parameter for the six-digit verification code.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TEMPLATE=
WHATSAPP_VERIFY_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v22.0

# Demo account passwords used by prisma/seed.js (never commit real values)
CUSTOMER_PASSWORD=
PROVIDER_PASSWORD=
ADMIN_PASSWORD=

# Google Sign-In (optional). Create an OAuth Client ID (Web application) in Google Cloud Console.
# The same client ID must be set as VITE_GOOGLE_CLIENT_ID in the frontend.
# GOOGLE_CLIENT_ID=
