# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL). For Aiven, paste the full URI from your Aiven service.
DATABASE_URL=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

PORT=5000

# Demo account passwords used by prisma/seed.js (never commit real values)
CUSTOMER_PASSWORD=
PROVIDER_PASSWORD=
ADMIN_PASSWORD=
