# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL). For Neon, paste the connection URI from your Neon console.
# For migrations when using connection pooling, also set DIRECT_URL (direct unpooled endpoint).
DATABASE_URL=
DIRECT_URL=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

# Server-side AES-256 key for provider bank account numbers (32-byte hex or 32+ char string). In dev, defaults to sha256(JWT_SECRET).
BANK_ENCRYPTION_KEY=

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
# Payment gateways work independently. The development Demo checkout grants
# real subscriptions and coins at zero cost, so production defaults it OFF.
# Set DEMO_PAYMENTS_ENABLED=true only if a deployment intentionally offers the
# zero-cost Demo checkout (staging/demos). Legacy PAYMENT_MODE=demo also opts
# in; development/test environments have Demo available without configuration.
PAYMENT_MODE=payhere
# DEMO_PAYMENTS_ENABLED=
TRUST_PROXY=false

# Public frontend URL used in reset/payment redirects
FRONTEND_URL=http://localhost:3000

# Payments (PayHere). Live checkout requires PUBLIC HTTPS return/cancel/notify
# URLs — plain http://localhost values fail the checkout readiness check.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=http://localhost:3000
PAYHERE_CANCEL_URL=http://localhost:3000
PAYHERE_NOTIFY_URL=

# NOWPayments Cryptocurrency Gateway
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@luxora.bond

# Durable private upload storage (required for multi-instance/ephemeral hosts)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PREFIX=uploads/

# Monthly payout queue (disabled unless explicitly enabled)
PAYOUT_SCHEDULER_ENABLED=false

# Required for shared rate limits across replicas. Use redis:// or rediss://
# from a secret/environment store; never commit a credential-bearing URI.
# Empty: bounded instance-local counters (development or one production instance).
# Configured but unavailable: limited endpoints return 503, never local fallback.
# Use one dedicated Redis database for all Luxora replicas, noeviction policy,
# private networking, authentication, and TLS where supported. See docs/RATE_LIMITING.md.
REDIS_URL=
# Tests only: isolated Redis URI, never production Redis. CI provides this.
# TEST_REDIS_URL=

# Prisma connection pool tuning (optional; sensible defaults apply)
# PRISMA_CONNECTION_LIMIT=
# PRISMA_POOL_TIMEOUT=

# Production guard: in production the seed script NEVER creates demo accounts.
# If this is set to "true" in production the seed fails loudly instead of
# silently skipping, so a misconfigured run is impossible to miss.
# SEED_DEMO_ACCOUNTS=
# Required by scripts/disable-public-seed-accounts.js to confirm disabling
# publicly known seed credentials on a production database.
# CONFIRM_PRODUCTION_SEED_ACCOUNT_REMEDIATION=

# Local/test fixture account passwords used by prisma/seed.js. Required outside
# production; use unique local values and never commit them.
CUSTOMER_PASSWORD=
PROVIDER_PASSWORD=
ADMIN_PASSWORD=

# Google Sign-In (optional). Create an OAuth Client ID (Web application) in Google Cloud Console.
# The same client ID must be set as VITE_GOOGLE_CLIENT_ID in the frontend.
# GOOGLE_CLIENT_ID=

# Chatbot concierge escalation contacts (optional). Defaults match the
# frontend chatbot config: +94 11 234 5678 / +94 77 100 0001.
# CHATBOT_CONCIERGE_PHONE=
# CHATBOT_CONCIERGE_WHATSAPP=
