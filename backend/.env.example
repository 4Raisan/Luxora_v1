# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL). For Aiven, paste the full URI from your Aiven service.
DATABASE_URL=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

PORT=5000

# Public frontend URL used in reset/payment redirects
FRONTEND_URL=http://localhost:3000

# Payments (sandbox first)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=http://localhost:3000
PAYHERE_CANCEL_URL=http://localhost:3000
PAYHERE_NOTIFY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Twilio Verify SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Demo account passwords used by prisma/seed.js (never commit real values)
CUSTOMER_PASSWORD=
PROVIDER_PASSWORD=
ADMIN_PASSWORD=
