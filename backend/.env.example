# Copy this file to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).

# Database (PostgreSQL).
# Local development uses the Docker Compose service — start it with:
#   docker compose up -d postgres   (from the repo root)
DATABASE_URL="postgresql://luxora_user:luxora_pass@127.0.0.1:5432/luxoradb?schema=public"
# Production uses the managed Neon PostgreSQL service URI (postgresql://...sslmode=require).
# Never point a local dev environment at the Neon production database.

# JWT signing secret (use a long random string in production)
JWT_SECRET=

PORT=5000

# PAYMENT_MODE=demo enables the local/test checkout; production uses payhere.
# NEVER set demo in production — it lets users activate paid plans without paying.
PAYMENT_MODE=demo

# PayHere checkout credentials. Without these the order endpoint returns a clean
# 503 "payments unavailable" instead of leaking configuration details.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# Uploaded-file storage (S3-compatible: AWS S3, Cloudflare R2, Clever Cellar...).
# When set, KYC documents and booking photos are stored durably in the bucket;
# when unset they fall back to local disk, which is LOST on every redeploy.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=            # required for R2/Cellar; leave empty for AWS S3
# S3_REGION=auto
# S3_PREFIX=uploads/

# Public frontend URL used in reset/payment redirects
FRONTEND_URL=http://localhost:3000

# Payments (sandbox first)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=http://localhost:3000
PAYHERE_CANCEL_URL=http://localhost:3000
PAYHERE_NOTIFY_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# EasySendSMS REST gateway (backend only). Sender ID must be approved by EasySendSMS.
EASYSENDSMS_API_KEY=
EASYSENDSMS_SENDER_ID=LUXORA

# Demo account passwords used by prisma/seed.js (never commit real values)
CUSTOMER_PASSWORD=
PROVIDER_PASSWORD=
ADMIN_PASSWORD=

# Google Sign-In (optional). Create an OAuth Client ID (Web application) in Google Cloud Console.
# The same client ID must be set as VITE_GOOGLE_CLIENT_ID in the frontend.
# GOOGLE_CLIENT_ID=
