{
  "name": "luxora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -n SERVER,WEB -c gold,cyan \"npm:backend\" \"npm:frontend\"",
    "build": "npm --prefix frontend run build",
    "lint": "oxlint",
    "test": "node backend/tests/run-tests.js",
    "test:ci-plan": "node --test scripts/ci/plan-checks.test.mjs scripts/ci/guard-protected-files.test.mjs",
    "test:ci-guard": "node --test scripts/ci/guard-protected-files.test.mjs",
    "graph": "node Knowladge-Graph/generate-graph.js && node Knowladge-Graph/generate-architecture.js",
    "graph:validate": "node Knowladge-Graph/validate-graph.js && node Knowladge-Graph/validate-architecture.js",
    "graph:verify": "npm run graph && npm run graph:validate",
    "graph:serve": "node scripts/serve-graph.mjs",
    "architecture:generate": "node Knowladge-Graph/generate-architecture.js",
    "architecture:validate": "node Knowladge-Graph/validate-architecture.js",
    "architecture:verify": "npm run architecture:generate && npm run architecture:validate",
    "architecture:dev": "node scripts/serve-graph.mjs",
    "demo:seed": "node backend/prisma/demo-bookings.js seed",
    "demo:clean": "node backend/prisma/demo-bookings.js clean"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "vis-network": "9.1.9",
    "vite": "^8.2.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
