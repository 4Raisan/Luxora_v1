{
  "name": "luxora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -n SERVER,WEB -c gold,cyan \"npm:backend\" \"npm:frontend\"",
    "build": "npm --prefix frontend run build",
    "lint": "oxlint",
    "test": "node backend/tests/run-tests.js",
    "graph": "node Knowladge-Graph/generate-graph.js",
    "graph:validate": "node Knowladge-Graph/validate-graph.js",
    "graph:verify": "npm run graph && npm run graph:validate",
    "demo:seed": "node backend/prisma/demo-bookings.js seed",
    "demo:clean": "node backend/prisma/demo-bookings.js clean"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
